{
  "name": "luma-code",
  "version": "1.5.0",
  "private": true,
  "description": "A focused desktop code editor with a project map, custom themes and SSH workspaces.",
  "author": "Luma Code",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/core.test.cjs tests/runtimes.test.cjs tests/privacy-install.test.cjs tests/discord-presence.test.cjs tests/ai.test.cjs",
    "test:app": "node tests/app.cjs",
    "package": "npm run build && electron-builder --win nsis",
    "test:effects": "node tests/enhancements.cjs",
    "test:runtimes": "node tests/runtimes-app.cjs",
    "test:privacy": "node tests/privacy-app.cjs",
    "test:discord": "node tests/discord-app.cjs",
    "test:ai": "node tests/ai-app.cjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "pyright": "^1.1.414",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vscode-jsonrpc": "^8.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@playwright/test": "^1.64.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.9.3",
    "concurrently": "^9.2.1",
    "electron": "44.9.1",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "dev.luma.code",
    "productName": "Luma Code",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*",
      "shared/**/*"
    ],
    "directories": {
      "output": "../../work/release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042",
      "artifactName": "LumaCode-Setup-${version}.${ext}"
    }
  },
  "type": "module"
}
